
name: ML Docker Build and Test

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

jobs:
  build-and-test:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.10"

      - name: Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Train ML Model
        run: |
          python train.py

      - name: Quality Gate
        run: |
          test -f model.pkl

      - name: Run Automated Tests
        run: |
          pytest -v

      - name: Build Docker Image
        run: |
          docker build -t student-result-prediction:latest .

      - name: Start Docker Container
        run: |
          docker run -d --name student-app -p 5000:5000 student-result-prediction:latest

      - name: Wait for Application
        run: sleep 10

      - name: Check Application Health
        run: |
          curl --fail http://localhost:5000/health

      - name: Test Prediction API
        run: |
          curl --fail -X POST http://localhost:5000/predict \
            -H "Content-Type: application/json" \
            -d '{"study_hours":5}'

      - name: Display Container Logs
        if: always()
        run: docker logs student-app || true

      - name: Remove Container
        if: always()
        run: docker rm -f student-app || true

      - name: Upload Release Artifact
        if: success()
        uses: actions/upload-artifact@v4
        with:
          name: release-candidate
          path: |
            Dockerfile
            requirements.txt
            model.pkl
          if-no-files-found: warn
